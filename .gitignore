# Bludit: sensitive databases (password hashes, tokens, logs)
bl-content/databases/users.php
bl-content/databases/security.php
bl-content/databases/syslog.php

# Bludit: plugin config that can hold credentials (SMTP, captcha keys)
bl-content/databases/plugins/contact3/db.php

# Bludit: runtime data (visit stats, contact messages, temp files)
bl-content/workspaces/
bl-content/tmp/

# Ignore sensitive files
*.log
*.sql
*.sqlite
*.db
.env

# Ignore dependency directories
node_modules/
vendor/

