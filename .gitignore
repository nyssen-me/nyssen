*.css.map
*.js.map
*.DS_Store
*.bak
*.swp
*.swo
*.tmp
*.lock

# Windows
desktop.ini
Thumbs.db

# Ignore IDE/editor files
.vscode/
.idea/
*.sublime-workspace
